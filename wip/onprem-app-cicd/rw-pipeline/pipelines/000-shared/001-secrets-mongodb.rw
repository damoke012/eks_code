/*
==============================================================================================================================
 Description:  MongoDB secrets for RisingWave. Required only by sinks that write to MongoDB.
==============================================================================================================================
 Split from 000-secrets.rw on 2026-08-26 -- see 000-secrets-kafka.rw for why.

 EXCLUDE this file wherever no MongoDB exists. On op-usxpress-qa as of 2026-08-26 there is
 no op-usxpress-qa/risingwave/mongodb secret, so it is excluded via EXCLUDE_RE alongside
 Brand/400-sink.rw. When a real QA MongoDB is provisioned, drop both patterns from the
 ConfigMap -- no rebuild, no new digest.
==============================================================================================================================
*/

-- ============================================================
-- MONGODB SECRETS
-- ============================================================

-- MongoDB Connection String (contains credentials)
DROP SECRET IF EXISTS mongodb_connection_string;
CREATE SECRET mongodb_connection_string WITH ( backend = 'meta' ) AS '%MONGODB_CONNECTION_STRING%';

-- MongoDB Username (for separate auth)
DROP SECRET IF EXISTS mongodb_username;
CREATE SECRET mongodb_username WITH ( backend = 'meta' ) AS '%MONGODB_USERNAME%';

-- MongoDB Password (for separate auth)
DROP SECRET IF EXISTS mongodb_password;
CREATE SECRET mongodb_password WITH ( backend = 'meta' ) AS '%MONGODB_PASSWORD%';
