/*
==============================================================================================================================
 Description:  Kafka secrets for RisingWave. Creates the SECRET objects that Kafka-backed
               sources and sinks can reference instead of inlining credentials.
==============================================================================================================================
 2026-10-13: placeholder names corrected to the LIVE contract. The 2026-08-26 draft used a
 naming scheme (KAFKA_API_KEY, KAFKA_GROUP_ID_PREFIX, KAFKA_SCHEMA_REGISTRY_ENDPOINT) that
 the pipelines on master do not use. apply.sh refuses a file whole when any placeholder is
 unset OR empty, and the apply is all-or-nothing, so shipping the old names would have
 killed every pipeline in every environment, not just this file.

 Every placeholder below is one that pipelines/100-Brand/100-sources.rw already resolves
 today, so this file adds no new variable requirement in any environment.

 KAFKA_SERVICE_ACCOUNT, KAFKA_RESOURCE_ID and KAFKA_REST_ENDPOINT are dropped: nothing
 supplies them and nothing consumes them.

 NOTE: nothing references these secrets yet. The sources still inline %KAFKA_SASL_PASSWORD%
 directly. This file is inert by design -- it creates the objects so the sources can be
 migrated to them in a separate, reviewable change.
==============================================================================================================================
*/

-- ============================================================
-- KAFKA SECRETS
-- ============================================================

DROP SECRET IF EXISTS kafka_bootstrap_server;
CREATE SECRET kafka_bootstrap_server WITH ( backend = 'meta' ) AS '%KAFKA_BOOTSTRAP_SERVER%';

DROP SECRET IF EXISTS kafka_security_protocol;
CREATE SECRET kafka_security_protocol WITH ( backend = 'meta' ) AS '%KAFKA_SECURITY_PROTOCOL%';

DROP SECRET IF EXISTS kafka_sasl_mechanism;
CREATE SECRET kafka_sasl_mechanism WITH ( backend = 'meta' ) AS '%KAFKA_SASL_MECHANISM%';

DROP SECRET IF EXISTS kafka_sasl_username;
CREATE SECRET kafka_sasl_username WITH ( backend = 'meta' ) AS '%KAFKA_SASL_USERNAME%';

DROP SECRET IF EXISTS kafka_sasl_password;
CREATE SECRET kafka_sasl_password WITH ( backend = 'meta' ) AS '%KAFKA_SASL_PASSWORD%';

DROP SECRET IF EXISTS kafka_group_id_prefix;
CREATE SECRET kafka_group_id_prefix WITH ( backend = 'meta' ) AS '%GROUP_ID_PREFIX%';

DROP SECRET IF EXISTS kafka_schema_registry_server;
CREATE SECRET kafka_schema_registry_server WITH ( backend = 'meta' ) AS '%KAFKA_SCHEMA_REGISTRY_SERVER%';

DROP SECRET IF EXISTS kafka_schema_registry_username;
CREATE SECRET kafka_schema_registry_username WITH ( backend = 'meta' ) AS '%KAFKA_SCHEMA_REGISTRY_USERNAME%';

DROP SECRET IF EXISTS kafka_schema_registry_password;
CREATE SECRET kafka_schema_registry_password WITH ( backend = 'meta' ) AS '%KAFKA_SCHEMA_REGISTRY_PASSWORD%';

-- List the names (never the values): SELECT * FROM rw_secrets;
