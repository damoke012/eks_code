/*
==============================================================================================================================
 Description:  Kafka secrets for RisingWave. Creates the SECRET objects every Kafka-backed
               source and sink references.
==============================================================================================================================
 Split from 000-secrets.rw on 2026-08-26. That file created Kafka AND MongoDB secrets
 together, so an environment with no MongoDB could not create its Kafka secrets either --
 the applier renders a file whole and refuses it if any placeholder is unresolvable.
 op-usxpress-qa has no .../risingwave/mongodb secret, which is what surfaced it.

 Values arrive as environment variables, rendered by build/apply.sh:
   credentials and endpoints -> the etl-pipeline-credentials ExternalSecret
   KAFKA_GROUP_ID_PREFIX     -> the overlay's etl-pipeline-endpoints ConfigMap, because it
                                is a per-environment CHOICE, not a stored credential. Two
                                environments sharing a prefix share a consumer group, and
                                Kafka then splits the partitions between them -- each would
                                silently see only part of the topic.
==============================================================================================================================
*/

-- ============================================================
-- KAFKA SECRETS
-- ============================================================

-- Kafka Bootstrap Server
DROP SECRET IF EXISTS kafka_bootstrap_server;
CREATE SECRET kafka_bootstrap_server WITH ( backend = 'meta' ) AS '%KAFKA_BOOTSTRAP_SERVER%';

-- Kafka Security Protocol (hardcoded for Confluent Cloud)
DROP SECRET IF EXISTS kafka_security_protocol;
CREATE SECRET kafka_security_protocol WITH ( backend = 'meta' ) AS 'SASL_SSL';

-- Kafka SASL Mechanism (hardcoded for Confluent Cloud)
DROP SECRET IF EXISTS kafka_sasl_mechanism;
CREATE SECRET kafka_sasl_mechanism WITH ( backend = 'meta' ) AS 'PLAIN';

-- Kafka API Key (used as SASL username)
DROP SECRET IF EXISTS kafka_api_key;
CREATE SECRET kafka_api_key WITH ( backend = 'meta' ) AS '%KAFKA_API_KEY%';

-- Kafka API Secret (used as SASL password)
DROP SECRET IF EXISTS kafka_api_secret;
CREATE SECRET kafka_api_secret WITH ( backend = 'meta' ) AS '%KAFKA_API_SECRET%';

-- Kafka Service Account
DROP SECRET IF EXISTS kafka_service_account;
CREATE SECRET kafka_service_account WITH ( backend = 'meta' ) AS '%KAFKA_SERVICE_ACCOUNT%';

-- Kafka Resource ID
DROP SECRET IF EXISTS kafka_resource_id;
CREATE SECRET kafka_resource_id WITH ( backend = 'meta' ) AS '%KAFKA_RESOURCE_ID%';

-- Kafka REST Endpoint
DROP SECRET IF EXISTS kafka_rest_endpoint;
CREATE SECRET kafka_rest_endpoint WITH ( backend = 'meta' ) AS '%KAFKA_REST_ENDPOINT%';

-- Kafka Group ID Prefix
DROP SECRET IF EXISTS kafka_group_id_prefix;
CREATE SECRET kafka_group_id_prefix WITH ( backend = 'meta' ) AS '%KAFKA_GROUP_ID_PREFIX%';

-- Kafka Schema Registry Endpoint
DROP SECRET IF EXISTS kafka_schema_registry_endpoint;
CREATE SECRET kafka_schema_registry_endpoint WITH ( backend = 'meta' ) AS '%KAFKA_SCHEMA_REGISTRY_ENDPOINT%';

-- Kafka Schema Registry API Key
DROP SECRET IF EXISTS kafka_schema_registry_api_key;
CREATE SECRET kafka_schema_registry_api_key WITH ( backend = 'meta' ) AS '%KAFKA_SCHEMA_REGISTRY_API_KEY%';

-- Kafka Schema Registry API Secret
DROP SECRET IF EXISTS kafka_schema_registry_api_secret;
CREATE SECRET kafka_schema_registry_api_secret WITH ( backend = 'meta' ) AS '%KAFKA_SCHEMA_REGISTRY_API_SECRET%';


-- ============================================================
-- VERIFY SECRETS (Optional - for debugging)
-- ============================================================
-- To list all secrets: SELECT * FROM rw_secrets;
-- Note: This only shows secret names, not values (values are encrypted)
