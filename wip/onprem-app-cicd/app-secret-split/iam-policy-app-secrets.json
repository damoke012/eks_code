{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadApplicationOwnedSecretsOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-2:*:secret:op-usxpress-dev/risingwave/app*"
    }
  ]
}
